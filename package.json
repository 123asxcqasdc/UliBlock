{
  "name": "uliblock",
  "description": "UliBlock \u2014 Scratch mod based on TurboWarp: compiler, dark mode, addons, custom extension gallery and more.",
  "version": "1.16.0",
  "license": "GPL-3.0",
  "author": {
    "email": "105458065+123asxcqasdc@users.noreply.github.com",
    "name": "123asxcqasdc"
  },
  "type": "commonjs",
  "scripts": {
    "fetch": "node scripts/download-library-files.mjs && node scripts/download-packager.mjs && node scripts/prepare-extensions.mjs",
    "webpack:compile": "webpack",
    "webpack:watch": "webpack --watch",
    "webpack:prod": "cross-env NODE_ENV=production webpack",
    "electron:start": "electron src-main/entrypoint.js",
    "electron:package:dir": "electron-builder --dir"
  },
  "dependencies": {
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.12.16",
    "@babel/preset-react": "^7.13.13",
    "@electron/fuses": "^2.1.2",
    "@turbowarp/extensions": "github:TurboWarp/extensions#master",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^9.8.8",
    "babel-loader": "^8.4.1",
    "copy-webpack-plugin": "^6.4.1",
    "cross-env": "^10.1.0",
    "css-loader": "^1.0.1",
    "electron": "^43.8.0",
    "electron-builder": "^26.15.3",
    "file-loader": "^6.2.0",
    "postcss": "^8.4.13",
    "postcss-import": "^14.0.0",
    "postcss-loader": "^4.2.0",
    "postcss-simple-vars": "^6.0.3",
    "scratch-gui": "github:123asxcqasdc/scratch-gui#uliblock",
    "style-loader": "^0.23.0",
    "url-loader": "^4.1.1",
    "webpack": "4.47.0",
    "webpack-cli": "^4.10.0"
  },
  "overrides": {
    "webpack@4.47.0": {
      "terser-webpack-plugin": "^4.2.3"
    },
    "@turbowarp/paper": "^0.12.202407262155",
    "scratch-render-fonts": "github:PenguinMod/penguinmod-render-fonts#master",
    "scratch-paint": {
      "react-responsive": "^5.0.0"
    }
  },
  "homepage": "https://github.com/123asxcqasdc/UliBlock",
  "repository": {
    "type": "git",
    "url": "https://github.com/123asxcqasdc/UliBlock.git"
  },
  "bugs": {
    "url": "https://github.com/123asxcqasdc/UliBlock/issues"
  },
  "main": "./src-main/entrypoint.js",
  "build": {
    "appId": "org.uliblock.desktop",
    "productName": "UliBlock",
    "files": [
      "node_modules/**/*",
      "src-main/**/*",
      "src-preload/**/*",
      "src-renderer/**/*",
      "dist-renderer-webpack/**/*",
      "dist-library-files/**/*",
      "dist-extensions/**/*"
    ],
    "extraResources": [
      {
        "from": "art/icon.png",
        "to": "icon.png"
      },
      {
        "from": "art/icon.svg",
        "to": "icon.svg"
      }
    ],
    "win": {
      "artifactName": "${productName} Portable ${version} ${arch}.${ext}",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        },
        {
          "target": "portable",
          "arch": "x64"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "executableName": "uliblock",
      "artifactName": "${productName}-${os}-${arch}-${version}.${ext}",
      "icon": "./build/",
      "synopsis": "Mod of Scratch with a compiler and more features.",
      "description": "UliBlock is a Scratch mod (based on TurboWarp) with a compiler to run projects faster, dark mode, addons, a custom extension gallery, and more.",
      "category": "Development",
      "desktop": {
        "entry": {
          "StartupWMClass": "uliblock",
          "Keywords": "scratch;"
        }
      },
      "extraFiles": [
        "linux-files"
      ],
      "target": [
        {
          "target": "deb"
        },
        {
          "target": "appimage"
        },
        {
          "target": "tar.gz"
        }
      ]
    },
    "appImage": {
      "license": null
    },
    "fileAssociations": [
      {
        "ext": "sb3",
        "name": "Scratch 3 Project",
        "description": "Scratch 3 Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.sb3"
      },
      {
        "ext": "sb2",
        "name": "Scratch 2 Project",
        "description": "Scratch 2 Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.sb2"
      },
      {
        "ext": "sb",
        "name": "Scratch 1 Project",
        "description": "Scratch 1 Project",
        "role": "Editor",
        "mimeType": "application/x.scratch.sb"
      }
    ]
  },
  "private": true
}
